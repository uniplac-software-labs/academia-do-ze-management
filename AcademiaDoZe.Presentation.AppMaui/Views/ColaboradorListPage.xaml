<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="AcademiaDoZe.Presentation.AppMaui.Views.ColaboradorListPage"
             xmlns:vm="clr-namespace:AcademiaDoZe.Presentation.AppMaui.ViewModels"
             x:DataType="vm:ColaboradorListViewModel"
             xmlns:dto="clr-namespace:AcademiaDoZe.Application.DTOs;assembly=AcademiaDoZe.Application"
             xmlns:converters="clr-namespace:AcademiaDoZe.Presentation.AppMaui.Converters"
             Title="{Binding Title}">

    <!-- Recursos locais: converters e o template usado para exibir cada colaborador na lista -->
    <ContentPage.Resources>
        <converters:FotoToImageSourceConverter x:Key="FotoToImageSourceConverter" />
        <converters:EnumDisplayConverter x:Key="EnumDisplay" />

        <!-- Template único, reaproveitado em qualquer dispositivo (Phone, Tablet, Desktop, TV) -->
        <DataTemplate x:Key="ColaboradorItemTemplate" x:DataType="dto:ColaboradorDto">
            <Grid Padding="1" Margin="5">
                <Border Style="{StaticResource CardBorder}" Margin="10">
                    <Grid RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto" ColumnDefinitions="*,Auto,Auto">

                        <Image Grid.Row="0" Grid.Column="1" Grid.ColumnSpan="2" Grid.RowSpan="9"
                               Source="{Binding Foto, Converter={StaticResource FotoToImageSourceConverter}}"
                               Aspect="AspectFill" Margin="0,0,10,0">
                            <!-- Tamanho ajustado conforme o tipo de dispositivo -->
                            <Image.HeightRequest>
                                <OnIdiom x:TypeArguments="x:Double">
                                    <OnIdiom.Phone>110</OnIdiom.Phone>
                                    <OnIdiom.Tablet>120</OnIdiom.Tablet>
                                    <OnIdiom.Desktop>120</OnIdiom.Desktop>
                                    <OnIdiom.TV>140</OnIdiom.TV>
                                    <OnIdiom.Default>110</OnIdiom.Default>
                                </OnIdiom>
                            </Image.HeightRequest>
                            <Image.WidthRequest>
                                <OnIdiom x:TypeArguments="x:Double">
                                    <OnIdiom.Phone>110</OnIdiom.Phone>
                                    <OnIdiom.Tablet>120</OnIdiom.Tablet>
                                    <OnIdiom.Desktop>120</OnIdiom.Desktop>
                                    <OnIdiom.TV>140</OnIdiom.TV>
                                    <OnIdiom.Default>110</OnIdiom.Default>
                                </OnIdiom>
                            </Image.WidthRequest>
                        </Image>

                        <Label Grid.Row="0" Grid.Column="0" Text="{Binding Nome}" FontAttributes="Bold" FontSize="16" Margin="0,0,0,5"/>
                        <Label Grid.Row="1" Grid.Column="0" Text="{Binding Cpf, StringFormat='CPF: {0}'}" Margin="0,0,0,5"/>
                        <Label Grid.Row="2" Grid.Column="0" Text="{Binding Telefone, StringFormat='Telefone: {0}'}" Margin="0,0,0,5"/>
                        <Label Grid.Row="3" Grid.Column="0" Text="{Binding Email, StringFormat='E-mail: {0}'}" Margin="0,0,0,5"/>
                        <Label Grid.Row="4" Grid.Column="0" Text="{Binding Tipo, Converter={StaticResource EnumDisplay}, StringFormat='Cargo: {0}'}" Margin="0,0,0,5"/>
                        <Label Grid.Row="5" Grid.Column="0" Text="{Binding Vinculo, Converter={StaticResource EnumDisplay}, StringFormat='Vínculo: {0}'}" Margin="0,0,0,5"/>
                        <Label Grid.Row="6" Grid.Column="0" Margin="0,0,0,5">
                            <Label.FormattedText>
                                <FormattedString>
                                    <Span Text="{Binding Endereco.Nome}"/>
                                    <Span Text=", "/>
                                    <Span Text="{Binding Numero}"/>
                                    <Span Text=" - "/>
                                    <Span Text="{Binding Endereco.Bairro}"/>
                                    <Span Text=", "/>
                                    <Span Text="{Binding Endereco.Cidade}"/>
                                    <Span Text=" - "/>
                                    <Span Text="{Binding Endereco.Estado}"/>
                                </FormattedString>
                            </Label.FormattedText>
                        </Label>

                        <Button Grid.Row="0" Grid.Column="1" Text="Editar" Style="{StaticResource ButtonSmall}" Margin="4,0" Clicked="OnEditButtonClicked" />
                        <Button Grid.Row="0" Grid.Column="2" Text="Excluir" Style="{StaticResource ButtonDanger}" Margin="4,0" Clicked="OnDeleteButtonClicked" />

                    </Grid>
                </Border>
            </Grid>
        </DataTemplate>
    </ContentPage.Resources>

    <!-- estrutura principal da página -->
    <Grid RowDefinitions="Auto,*">

        <!-- Search Bar com Picker de filtro -->
        <Border Grid.Row="0" Style="{StaticResource CardBorder}" Margin="15,10">
            <Grid ColumnDefinitions="Auto,10,*,10,Auto" VerticalOptions="Center">
                <Picker Grid.Column="0" Title="" ItemsSource="{Binding FilterTypes}" SelectedItem="{Binding SelectedFilterType}" WidthRequest="110" HorizontalOptions="Start" HeightRequest="40" VerticalOptions="Center"/>
                <Entry Grid.Column="2" Text="{Binding SearchText}" Placeholder="Digite o valor..." HeightRequest="40" VerticalOptions="Center" ClearButtonVisibility="WhileEditing" ReturnCommand="{Binding SearchColaboradoresCommand}" />
                <Button Grid.Column="4" Text="Buscar" Style="{StaticResource ButtonPrimary}" FontSize="14" WidthRequest="80" HeightRequest="40" Command="{Binding SearchColaboradoresCommand}"/>
            </Grid>
        </Border>

        <!-- Lista/grade de colaboradores + FAB. A quantidade de colunas se ajusta conforme o dispositivo -->
        <Grid Grid.Row="1">
            <RefreshView IsRefreshing="{Binding IsRefreshing}" Command="{Binding RefreshCommand}">
                <CollectionView ItemsSource="{Binding Colaboradores}" SelectionMode="None" Margin="10">
                    <CollectionView.ItemsLayout>
                        <GridItemsLayout Orientation="Vertical">
                            <!-- Lista no celular, grade em dispositivos maiores -->
                            <GridItemsLayout.Span>
                                <OnIdiom x:TypeArguments="x:Int32">
                                    <OnIdiom.Phone>1</OnIdiom.Phone>
                                    <OnIdiom.Default>1</OnIdiom.Default>
                                    <OnIdiom.Tablet>2</OnIdiom.Tablet>
                                    <OnIdiom.Desktop>3</OnIdiom.Desktop>
                                    <OnIdiom.TV>4</OnIdiom.TV>
                                </OnIdiom>
                            </GridItemsLayout.Span>
                        </GridItemsLayout>
                    </CollectionView.ItemsLayout>

                    <CollectionView.EmptyView>
                        <StackLayout VerticalOptions="Center">
                            <Label Text="Nenhum colaborador encontrado" HorizontalOptions="Center" Style="{StaticResource SubHeadline}"/>
                            <Button Text="Adicionar Primeiro Colaborador" Command="{Binding AddColaboradorCommand}" Style="{StaticResource ButtonPrimary}" HeightRequest="50" Margin="0,20,0,0"/>
                        </StackLayout>
                    </CollectionView.EmptyView>

                    <CollectionView.ItemTemplate>
                        <StaticResource Key="ColaboradorItemTemplate" />
                    </CollectionView.ItemTemplate>
                </CollectionView>
            </RefreshView>

            <!-- Floating Action Button -->
            <Button Command="{Binding AddColaboradorCommand}" Style="{StaticResource ButtonPrimary}" Text="+"
                    WidthRequest="56" HeightRequest="56" HorizontalOptions="End" VerticalOptions="End" Margin="20" CornerRadius="28" Padding="0">
                <Button.Shadow>
                    <Shadow Brush="{AppThemeBinding Light=Black, Dark=Gray}" Offset="0,4" Radius="8" Opacity="0.3"/>
                </Button.Shadow>
            </Button>
        </Grid>

        <!-- Loading Indicator -->
        <ActivityIndicator Grid.Row="0" Grid.RowSpan="2" IsVisible="{Binding IsBusy}" IsRunning="{Binding IsBusy}" VerticalOptions="Center" HorizontalOptions="Center"/>

    </Grid>
</ContentPage>
